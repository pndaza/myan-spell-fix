{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myan-spell-fix",
  // Set to today's date when deploying for the first time.
  "compatibility_date": "2026-09-01",
  // Pure static hosting — there is no server code. The app runs entirely in
  // the browser: the user's own Gemini API key (stored in their browser's
  // localStorage) is sent only to generativelanguage.googleapis.com.
  "assets": {
    // Populated automatically by @cloudflare/vite-plugin from the client
    // build output.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
